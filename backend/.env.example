# ─────────────────────────────────────────────────────────────
# Drew's Guide Service — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001

# CORS — comma-separated list of allowed frontend origins
# Local dev:   http://localhost:3000
# Production:  https://your-frontend.hosterr.com
ALLOWED_ORIGINS=http://localhost:3000

# Brevo Email API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email@example.com
BREVO_SENDER_NAME=Drew's Guide Service

# Drew's notification inbox (receives new booking alerts)
DREW_NOTIFICATION_EMAIL=drew@example.com

# Brevo mailing list ID for the newsletter (integer)
# Find this in Brevo → Contacts → Lists → click your list → the ID is in the URL
BREVO_LIST_ID=1
