# SPA routing for Apache/LiteSpeed hosting (Netlify uses _redirects instead).
# Client-side routes like /tour/x, /booking-request, /admin must serve
# index.html; real files (static assets, images, videos) are served directly.
Options -MultiViews
RewriteEngine On
RewriteBase /

# Never rewrite API calls — the panel proxies /api to the Express backend
RewriteRule ^api/ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# CRA hashes JS/CSS filenames — safe to cache forever
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
